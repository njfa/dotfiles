// Zellij main config
theme "tokyo-night-dark"
pane_frames false
simplified_ui false
copy_on_select true
copy_command "zellij-copy"
default_mode "normal"

// Alt-centric bindings with normal default to avoid Ctrl conflicts in editors.
keybinds clear-defaults=true {
    unbind "Ctrl g"
    unbind "Ctrl p"
    unbind "Ctrl n"
    unbind "Ctrl s"
    unbind "Ctrl t"
    unbind "Ctrl h"
    unbind "Ctrl b"
    unbind "Ctrl o"
    unbind "Enter"
    unbind "Esc"
    unbind "Alt g"
    unbind "Alt d"

    normal {
        // Tabs
        bind "Alt c" { NewTab; }
        bind "Alt b" { GoToPreviousTab; }
        bind "Alt n" { GoToNextTab; }

        // Pane split
        bind "Alt e" { NewPane "Down"; }
        bind "Alt i" { NewPane "Right"; }

        // Pane focus move (vim-style)
        bind "Alt h" { MoveFocusOrTab "Left"; }
        bind "Alt j" { MoveFocus "Down"; }
        bind "Alt k" { MoveFocus "Up"; }
        bind "Alt l" { MoveFocusOrTab "Right"; }

        // Fullscreen + close
        bind "Alt f" { ToggleFocusFullscreen; }
        bind "Alt x" { CloseFocus; }

        // Sync
        bind "Alt a" { ToggleActiveSyncTab; }
        bind "Alt v" { EditScrollback; }

        bind "Alt d" {
            Run "lazydocker" {
                close_on_exit true
                floating true
                x "2%"
                y "2%"
                width "98%"
                height "98%"
            }
        }
        bind "Alt g" {
            Run "lazygit" {
                close_on_exit true
                floating true
                x "2%"
                y "2%"
                width "98%"
                height "98%"
            }
        }

        // Floating tools
        bind "Alt p" {
            Run "zellij-open-monitor" {
                close_on_exit true
                floating true
                x "5%"
                y "5%"
                width "90%"
                height "90%"
            }
        }
        bind "Alt s" {
            LaunchOrFocusPlugin "session-manager" {
                floating true
                move_to_focused_tab true
            }
        }

        // Pane mode
        bind "Ctrl o" { SwitchToMode "Pane"; }
    }
    pane {
        bind "Ctrl o" { SwitchToMode "Normal"; }
        bind "d" { Detach; }
        bind "h" { Resize "Increase Left"; }
        bind "j" { Resize "Increase Down"; }
        bind "k" { Resize "Increase Up"; }
        bind "l" { Resize "Increase Right"; }
        bind "H" { Resize "Decrease Left"; }
        bind "J" { Resize "Decrease Down"; }
        bind "K" { Resize "Decrease Up"; }
        bind "L" { Resize "Decrease Right"; }
        bind "Left" { MovePane "Left"; }
        bind "Down" { MovePane "Down"; }
        bind "Up" { MovePane "Up"; }
        bind "Right" { MovePane "Right"; }
    }
}
