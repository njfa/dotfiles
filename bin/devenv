#!/usr/bin/env bash
set -euo pipefail

readonly RESET=$'\033[0m'
readonly GREY=$'\033[90m'
readonly RED=$'\033[31m'
readonly GREEN=$'\033[32m'
readonly CYAN=$'\033[36m'

devenv_lang() {
  case "${DEVENV_LANG:-}" in
    ja)
      printf 'ja\n'
      return
      ;;
    en)
      printf 'en\n'
      return
      ;;
    '')
      ;;
    *)
      printf 'en\n'
      return
      ;;
  esac

  case "${LANG:-}" in
    ja|ja_*|ja.*)
      printf 'ja\n'
      ;;
    *)
      printf 'en\n'
      ;;
  esac
}

usage() {
  cat >&2 <<'USAGE'
Usage: devenv [command] [args...]

Commands:
  install [--repo URL] [--branch NAME] [--path PATH]
  mise [args...]
  chezmoi [args...]
  apm [args...]
  help [command]
USAGE
}

help_overview() {
  case "$(devenv_lang)" in
    ja)
      cat <<'HELP'
devenv - dotfilesの初期化とツール委譲コマンド

使い方:
  devenv
  devenv install [--repo URL] [--branch NAME] [--path PATH]
  devenv mise [args...]
  devenv chezmoi [args...]
  devenv apm [args...]
  devenv help [command]

コマンド:
  install   dotfilesをclone後、clone先のbin/devenvを実行
  mise      miseをインストール後、miseへ引数を委譲
  chezmoi   chezmoiをインストール後、chezmoiへ引数を委譲
  apm       apmをインストール後、apmへ引数を委譲
  help      全体helpまたはコマンド別helpを表示

例:
  devenv
  devenv install --path "$HOME/.dotfiles" --branch main
  devenv mise run deploy
  devenv chezmoi apply --source .
  devenv apm --version

コマンド別の詳細は `devenv help <command>` を実行してください。
HELP
      ;;
    *)
      cat <<'HELP'
devenv - dotfiles bootstrap and passthrough command

Usage:
  devenv
  devenv install [--repo URL] [--branch NAME] [--path PATH]
  devenv mise [args...]
  devenv chezmoi [args...]
  devenv apm [args...]
  devenv help [command]

Commands:
  install   Clone dotfiles and run the cloned devenv
  mise      Ensure mise, then pass arguments through to mise
  chezmoi   Ensure chezmoi, then pass arguments through to chezmoi
  apm       Ensure apm, then pass arguments through to apm
  help      Show overview or command-specific help

Examples:
  devenv
  devenv install --path "$HOME/.dotfiles" --branch main
  devenv mise run deploy
  devenv chezmoi apply --source .
  devenv apm --version

Run `devenv help <command>` for command-specific details.
HELP
      ;;
  esac
}

help_install() {
  case "$(devenv_lang)" in
    ja)
      cat <<'HELP'
devenv install - dotfilesをclone後、clone先のbin/devenvを実行

使い方:
  devenv install [--repo URL] [--branch NAME] [--path PATH]

オプション:
  --repo URL       cloneするGit repository。Default: https://github.com/njfa/dotfiles.git
  --branch NAME    cloneするGit branch。Default: main
  --path PATH      install先。Default: ${DOTFILES_PATH:-$HOME/.dotfiles}

例:
  curl -fsSL https://raw.githubusercontent.com/njfa/dotfiles/main/bin/devenv | bash -s -- install
  devenv install --path "$HOME/.dotfiles" --branch main

補足:
  install先が既に存在する場合はgit clone前に停止します。
HELP
      ;;
    *)
      cat <<'HELP'
devenv install - clone dotfiles and run the cloned devenv

Usage:
  devenv install [--repo URL] [--branch NAME] [--path PATH]

Options:
  --repo URL       Git repository to clone. Default: https://github.com/njfa/dotfiles.git
  --branch NAME    Git branch to clone. Default: main
  --path PATH      Install target. Default: ${DOTFILES_PATH:-$HOME/.dotfiles}

Examples:
  curl -fsSL https://raw.githubusercontent.com/njfa/dotfiles/main/bin/devenv | bash -s -- install
  devenv install --path "$HOME/.dotfiles" --branch main

Notes:
  Existing target paths stop the install before git clone.
HELP
      ;;
  esac
}

help_mise() {
  case "$(devenv_lang)" in
    ja)
      cat <<'HELP'
devenv mise - miseへ引数を委譲

使い方:
  devenv mise [args...]

動作:
  miseへ引数を委譲します。
  miseが未導入の場合はインストールします。
  単純な委譲ではmise configをコピーしません。

例:
  devenv mise --version
  devenv mise tasks
  devenv mise run deploy
HELP
      ;;
    *)
      cat <<'HELP'
devenv mise - pass arguments through to mise

Usage:
  devenv mise [args...]

Behavior:
  Passes arguments through to mise.
  Installs mise when missing.
  Simple passthrough does not copy the mise config.

Examples:
  devenv mise --version
  devenv mise tasks
  devenv mise run deploy
HELP
      ;;
  esac
}

help_chezmoi() {
  case "$(devenv_lang)" in
    ja)
      cat <<'HELP'
devenv chezmoi - chezmoiへ引数を委譲

使い方:
  devenv chezmoi [args...]

動作:
  chezmoiが未導入の場合はmise経由でインストールします。
  setup後にchezmoiへ引数を委譲します。

例:
  devenv chezmoi apply --source .
  devenv chezmoi managed
HELP
      ;;
    *)
      cat <<'HELP'
devenv chezmoi - pass arguments through to chezmoi

Usage:
  devenv chezmoi [args...]

Behavior:
  Installs chezmoi through mise when missing.
  Passes arguments through to chezmoi after setup.

Examples:
  devenv chezmoi apply --source .
  devenv chezmoi managed
HELP
      ;;
  esac
}

help_apm() {
  case "$(devenv_lang)" in
    ja)
      cat <<'HELP'
devenv apm - apmへ引数を委譲

使い方:
  devenv apm [args...]

動作:
  apmが未導入の場合はmiseでpipx:apm-cliとしてインストールします。
  setup後にapmへ引数を委譲します。

例:
  devenv apm --version
HELP
      ;;
    *)
      cat <<'HELP'
devenv apm - pass arguments through to apm

Usage:
  devenv apm [args...]

Behavior:
  Installs apm through mise as pipx:apm-cli when missing.
  Passes arguments through to apm after setup.

Examples:
  devenv apm --version
HELP
      ;;
  esac
}

show_help() {
  case "${1:-}" in
    ''|-h|--help|help)
      help_overview
      ;;
    install)
      help_install
      ;;
    mise)
      help_mise
      ;;
    chezmoi)
      help_chezmoi
      ;;
    apm)
      help_apm
      ;;
    *)
      printf 'Unknown help topic: %s\n' "$1" >&2
      usage
      return 2
      ;;
  esac
}

run_formatted() {
  local label=$1
  shift

  printf '\n%s[RUN] %s%s\n' "$CYAN" "$label" "$RESET"

  local status
  set +e
  "$@" 2>&1 | while IFS= read -r line; do
    printf '%s│%s %s\n' "$GREY" "$RESET" "$line"
  done
  status=${PIPESTATUS[0]}
  set -e

  if [[ $status -eq 0 ]]; then
    printf '%s[OK] %s%s\n' "$GREEN" "$label" "$RESET"
  else
    printf '%s[FAIL] %s exited with %s%s\n' "$RED" "$label" "$status" "$RESET" >&2
  fi

  return "$status"
}

ensure_git() {
  if command -v git >/dev/null 2>&1; then
    return 0
  fi

  if command -v apt-get >/dev/null 2>&1; then
    if command -v sudo >/dev/null 2>&1; then
      sudo apt-get update
      sudo apt-get install -y git
    elif [[ $(id -u) -eq 0 ]]; then
      apt-get update
      apt-get install -y git
    fi
  fi

  if ! command -v git >/dev/null 2>&1; then
    printf 'git is required to install dotfiles.\n' >&2
    exit 1
  fi
}

install_dotfiles() {
  local repo='https://github.com/njfa/dotfiles.git'
  local branch='main'
  local target_path="${DOTFILES_PATH:-$HOME/.dotfiles}"

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --repo)
        if [[ $# -lt 2 || -z ${2:-} ]]; then
          usage
          return 2
        fi
        repo=$2
        shift 2
        ;;
      --branch)
        if [[ $# -lt 2 || -z ${2:-} ]]; then
          usage
          return 2
        fi
        branch=$2
        shift 2
        ;;
      --path)
        if [[ $# -lt 2 || -z ${2:-} ]]; then
          usage
          return 2
        fi
        target_path=$2
        shift 2
        ;;
      -h|--help)
        help_install
        return 0
        ;;
      *)
        usage
        return 2
        ;;
    esac
  done

  if [[ -z $repo || -z $branch || -z $target_path ]]; then
    usage
    return 2
  fi

  if [[ -e $target_path ]]; then
    printf 'Install target already exists: %s\n' "$target_path" >&2
    return 1
  fi

  ensure_git
  run_formatted 'git clone' git clone --branch "$branch" -- "$repo" "$target_path"
  "$target_path/bin/devenv"
}

if [[ ${1:-} == install ]]; then
  shift
  install_dotfiles "$@"
  exit $?
fi

if [[ ${1:-} == help || ${1:-} == --help || ${1:-} == -h ]]; then
  if [[ ${1:-} == help ]]; then
    shift
  fi
  show_help "${1:-}"
  exit $?
fi

SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
DOTFILES_PATH=$(cd "$SCRIPT_DIR/.." && pwd)
export DOTFILES_PATH
MISE_CONFIG_PATH="$DOTFILES_PATH/dot_config/mise/config.toml"
export MISE_CONFIG_FILE="$MISE_CONFIG_PATH"
MISE_BIN=''

ensure_mise() {
  if command -v mise >/dev/null 2>&1; then
    MISE_BIN=$(command -v mise)
    return 0
  fi

  if ! command -v curl >/dev/null 2>&1; then
    if command -v apt-get >/dev/null 2>&1; then
      if command -v sudo >/dev/null 2>&1; then
        sudo apt-get update
        sudo apt-get install -y curl
      elif [[ $(id -u) -eq 0 ]]; then
        apt-get update
        apt-get install -y curl
      else
        printf 'curl is required to install mise.\n' >&2
        exit 1
      fi
    fi
  fi

  if ! command -v curl >/dev/null 2>&1; then
    printf 'curl is required to install mise.\n' >&2
    exit 1
  fi

  curl -fsSL https://mise.jdx.dev/install.sh | sh
  export PATH="$HOME/.local/bin:$PATH"
  MISE_BIN=$(command -v mise)
}

ensure_mise_config() {
  local target_dir="$HOME/.config/mise"
  local target_path="$target_dir/config.toml"

  mkdir -p "$target_dir"
  if [[ ! -f "$target_path" ]] || ! cmp -s "$MISE_CONFIG_PATH" "$target_path"; then
    cp "$MISE_CONFIG_PATH" "$target_path"
  fi
}

activate_mise() {
  export PATH="$HOME/.local/bin:$PATH"
  if [[ -n $MISE_BIN ]]; then
    local activation
    activation=$("$MISE_BIN" activate bash)
    if [[ $activation == *'export '* || $activation == *'PATH='* || $activation == *'mise '* ]]; then
      eval "$activation"
    fi
  fi
}

trust_mise_config() {
  (cd "$DOTFILES_PATH" && MISE_YES=1 "$MISE_BIN" trust) >/dev/null 2>&1 || true
}

ensure_base() {
  ensure_mise
  ensure_mise_config
  activate_mise
  trust_mise_config
}

ensure_mise_passthrough() {
  ensure_mise
  activate_mise
}

ensure_tool() {
  local command_name=$1
  local mise_tool_spec=$2

  if command -v "$command_name" >/dev/null 2>&1; then
    return 0
  fi

  ensure_base
  run_formatted "mise install $mise_tool_spec" "$MISE_BIN" install "$mise_tool_spec"
  activate_mise
}

main() {
  case "${1:-}" in
    '')
      ensure_base
      run_formatted 'mise install' "$MISE_BIN" install
      run_formatted 'mise run setup' "$MISE_BIN" run setup
      ;;
    install)
      shift
      install_dotfiles "$@"
      ;;
    mise)
      shift
      ensure_mise_passthrough
      run_formatted "mise $*" "$MISE_BIN" "$@"
      ;;
    chezmoi)
      shift
      ensure_tool chezmoi chezmoi
      run_formatted "chezmoi $*" chezmoi "$@"
      ;;
    apm)
      shift
      ensure_tool apm 'pipx:apm-cli'
      run_formatted "apm $*" apm "$@"
      ;;
    *)
      usage
      return 2
      ;;
  esac
}

main "$@"
