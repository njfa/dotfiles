#!/usr/bin/env sh

has_cmd() {
  command -v "$1" >/dev/null 2>&1
}

try_cmd() {
  if "$@"; then
    exit 0
  fi
}

if has_cmd win32yank.exe; then
  try_cmd win32yank.exe -i
fi

if has_cmd clip.exe; then
  try_cmd clip.exe
fi

if has_cmd wl-copy; then
  try_cmd wl-copy
fi

if has_cmd xclip; then
  try_cmd xclip -selection clipboard
fi

if has_cmd xsel; then
  try_cmd xsel --clipboard --input
fi

if has_cmd pbcopy; then
  try_cmd pbcopy
fi

if has_cmd base64; then
  data=$(base64 | tr -d '\n')
  if [ -w /dev/tty ]; then
    printf '\033]52;c;%s\a' "$data" > /dev/tty
  else
    printf '\033]52;c;%s\a' "$data"
  fi
  exit 0
fi

echo "zellij-copy: no clipboard helper found" >&2
exit 1
