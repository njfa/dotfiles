#!/usr/bin/env bash
set -euo pipefail

has_cmd() {
  command -v "$1" >/dev/null 2>&1
}

if has_cmd win32yank.exe; then
  # Keep stdin intact if win32yank consumes it before failing (e.g. interop
  # disabled). A private temporary file also preserves trailing newlines.
  input=$(mktemp)
  trap 'rm -f "$input"' EXIT
  cat > "$input"
  if win32yank.exe -i --crlf < "$input"; then
    exit 0
  fi
  exec < "$input"
fi

if ! has_cmd base64; then
  echo "tmux-copy: base64 not found for OSC52 fallback" >&2
  exit 1
fi

payload=$(base64 | tr -d '\n')
if ! { printf '\033]52;c;%s\a' "$payload" > /dev/tty; } 2>/dev/null; then
  printf '\033]52;c;%s\a' "$payload"
fi
exit 0
